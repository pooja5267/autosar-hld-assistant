# =====================================================================
# AUTOSAR HLD Document Analysis Assistant - Environment Configuration
# =====================================================================

# LLM Provider Configuration
# Supported options: "offline", "openai", "groq", "gemini", "anthropic", "ollama"
# Default is "offline" (rule-based extractive mode, no API key required)
LLM_PROVIDER=offline

# API Keys (leave blank if using "offline" or local "ollama")
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# LLM Model Name
# Examples:
#   OpenAI: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
#   Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
#   Gemini: gemini-1.5-flash, gemini-1.5-pro
#   Anthropic: claude-3-5-sonnet-20241022, claude-3-haiku-20240307
#   Ollama: llama3, mistral, qwen2.5
LLM_MODEL=llama-3.3-70b-versatile

# Custom LLM Base URL (optional, e.g., for local Ollama: http://localhost:11434/v1)
LLM_BASE_URL=

# Vector Database Settings
CHROMA_PERSIST_DIR=./data/chroma_db
COLLECTION_NAME=autosar_hld_docs

# Embedding Model Configuration
# Options: "all-MiniLM-L6-v2" (local ONNX/PyTorch)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Retrieval Pipeline Parameters
RETRIEVAL_TOP_K=4
SIMILARITY_THRESHOLD=0.35

# Upload Constraints
MAX_FILE_SIZE_MB=20
